# Anonix Gateway Configuration Template
# Copy to .env for local or Docker Compose deployments.

# Environment: "development" (single-node convenience) or "production" (strict fail-closed startup)
ANONIX_ENV=development

# Server bind address and port
ANONIX_HOST=0.0.0.0
ANONIX_PORT=8000
ANONIX_LOG_LEVEL=INFO

# Tenancy mode: "single_org" (default) or "multi_tenant"
ANONIX_TENANCY_MODE=single_org

# Database URL (leave blank for automatic local SQLite: sqlite+aiosqlite:///./data/anonix.db)
# For bundled Docker Postgres: postgresql+asyncpg://anonix:anonix@postgres:5432/anonix
# For BYOD Enterprise Postgres: postgresql+asyncpg://user:password@db.company.internal:5432/anonix
# ANONIX_DATABASE_URL=

# Redis URL (optional; leave blank for built-in in-memory rate limiting)
# ANONIX_REDIS_URL=redis://redis:6379/0

# Cryptographic secrets (generate with: anonix-gateway keygen)
# Required in ANONIX_ENV=production. In development, auto-generated & persisted in ANONIX_DATA_DIR.
# ANONIX_MASTER_KEY=
# ANONIX_ADMIN_JWT_SECRET=

# Local data directory for SQLite and auto-generated development secrets
ANONIX_DATA_DIR=./data

# Optional headless first-run bootstrap (leave blank to use Web /setup or `anonix-gateway init`)
# ANONIX_BOOTSTRAP_ADMIN_EMAIL=
# ANONIX_BOOTSTRAP_ADMIN_PASSWORD=
# ANONIX_BOOTSTRAP_ORG_NAME=Default Organization

# Optional CORS origins (comma-separated) for standalone frontend dev
# ANONIX_CORS_ORIGINS=http://localhost:5173

# Optional native HTTPS/TLS (provide both to serve HTTPS directly without an external proxy)
# ANONIX_SSL_CERTFILE=/certs/fullchain.pem
# ANONIX_SSL_KEYFILE=/certs/privkey.pem

# Optional domain for automatic Let's Encrypt HTTPS with `docker compose --profile tls up -d`
# ANONIX_DOMAIN=mask.example.com
